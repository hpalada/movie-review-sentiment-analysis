class AddMovieCard(QFrame):
    clicked = pyqtSignal()

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setFixedSize(220, 280)
        self.setObjectName("AddMovieCard")
        self.setCursor(QCursor(Qt.CursorShape.PointingHandCursor))
        self.setStyleSheet("""
            QFrame#AddMovieCard {
                background: #13162200;
                border-radius: 14px;
                border: 2px dashed #2a2f45;
            }
            QFrame#AddMovieCard:hover {
                background: #1a1f3a;
                border: 2px dashed #00c8b4;
            }
        """)

        layout = QVBoxLayout(self)
        layout.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.setSpacing(12)

        icon = QLabel("＋")
        icon.setAlignment(Qt.AlignmentFlag.AlignCenter)
        icon.setStyleSheet(
            "color:#2a2f45; font-size:52px; font-weight:300; border:none;"
        )
        icon.setObjectName("AddIcon")

        text = QLabel("Agregar película")
        text.setAlignment(Qt.AlignmentFlag.AlignCenter)
        text.setStyleSheet(
            "color:#3a4565; font-size:13px; font-weight:600; border:none;"
        )
        text.setObjectName("AddText")

        layout.addWidget(icon)
        layout.addWidget(text)

        self._icon = icon
        self._text = text

    def enterEvent(self, event):
        self._icon.setStyleSheet(
            "color:#00c8b4; font-size:52px; font-weight:300; border:none;"
        )
        self._text.setStyleSheet(
            "color:#00c8b4; font-size:13px; font-weight:600; border:none;"
        )
        super().enterEvent(event)

    def leaveEvent(self, event):
        self._icon.setStyleSheet(
            "color:#2a2f45; font-size:52px; font-weight:300; border:none;"
        )
        self._text.setStyleSheet(
            "color:#3a4565; font-size:13px; font-weight:600; border:none;"
        )
        super().leaveEvent(event)

    def mousePressEvent(self, event):
        if event.button() == Qt.MouseButton.LeftButton:
            self.clicked.emit()
        super().mousePressEvent(event)


